{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cards"
  ],
  "properties": {
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card_id",
          "prose_sha256",
          "verdict",
          "reason",
          "claims"
        ],
        "properties": {
          "card_id": {
            "type": "string"
          },
          "prose_sha256": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supported",
              "unsupported",
              "uncertain"
            ]
          },
          "reason": {
            "type": "string"
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "text",
                "source_id",
                "source_sha256",
                "quote"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "headline",
                    "why_it_matters",
                    "body"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "source_id": {
                  "type": "string"
                },
                "source_sha256": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
