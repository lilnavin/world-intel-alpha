{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "briefing",
    "kb_deltas",
    "source_notes"
  ],
  "properties": {
    "briefing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finance",
        "post_earnings"
      ],
      "properties": {
        "finance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "brief",
            "scoreboard_note",
            "scoreboard_read",
            "filings_note",
            "earnings_note"
          ],
          "properties": {
            "brief": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "headline",
                  "why_it_matters",
                  "body",
                  "sources",
                  "tags",
                  "region"
                ],
                "properties": {
                  "headline": {
                    "type": "string"
                  },
                  "why_it_matters": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "outlet",
                        "url"
                      ],
                      "properties": {
                        "outlet": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "region": {
                    "type": "string",
                    "enum": [
                      "US",
                      "AMERICAS",
                      "ASIA",
                      "MENA",
                      "EUROPE",
                      "GLOBAL"
                    ]
                  }
                }
              }
            },
            "scoreboard_note": {
              "type": "string"
            },
            "scoreboard_read": {
              "type": [
                "object",
                "null"
              ],
              "required": [
                "contradiction",
                "precedent",
                "watch"
              ],
              "additionalProperties": false,
              "properties": {
                "contradiction": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "statement",
                    "story"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "statement": {
                      "type": "string"
                    },
                    "story": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "precedent": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "watch": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "object",
                    "required": [
                      "condition",
                      "story"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "condition": {
                        "type": "string"
                      },
                      "story": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "filings_note": {
              "type": "string"
            },
            "earnings_note": {
              "type": "string"
            }
          }
        },
        "post_earnings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "writeups",
            "also_reported",
            "followups"
          ],
          "properties": {
            "writeups": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ticker",
                  "headline",
                  "company",
                  "guidance",
                  "guidance_struct",
                  "read",
                  "read_through",
                  "tags"
                ],
                "properties": {
                  "ticker": {
                    "type": "string"
                  },
                  "headline": {
                    "type": "string"
                  },
                  "company": {
                    "type": "string"
                  },
                  "guidance": {
                    "type": "string"
                  },
                  "guidance_struct": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "metric": {
                        "enum": [
                          "eps_q",
                          "eps_fy",
                          "revenue_q",
                          "revenue_fy",
                          "other"
                        ]
                      },
                      "low": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "high": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "metric",
                      "low",
                      "high"
                    ],
                    "additionalProperties": false
                  },
                  "read": {
                    "type": "string"
                  },
                  "read_through": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "also_reported": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ticker",
                  "note"
                ],
                "properties": {
                  "ticker": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            },
            "followups": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ticker",
                  "headline",
                  "body",
                  "panel_read",
                  "segment_read",
                  "quotes"
                ],
                "properties": {
                  "ticker": {
                    "type": "string"
                  },
                  "headline": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "panel_read": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "segment_read": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "quotes": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "section",
                        "text"
                      ],
                      "properties": {
                        "section": {
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "kb_deltas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities_upsert",
        "threads_upsert"
      ],
      "properties": {
        "entities_upsert": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slug",
              "type",
              "summary",
              "facts",
              "threads"
            ],
            "properties": {
              "slug": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "facts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "threads": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "threads_upsert": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slug",
              "status",
              "summary",
              "timeline_add",
              "watch",
              "expectations_add"
            ],
            "properties": {
              "slug": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "timeline_add": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "date",
                    "note"
                  ],
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              },
              "watch": {
                "type": "string"
              },
              "expectations_add": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "metric",
                    "consensus",
                    "release_date",
                    "source"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "metric": {
                      "type": "string"
                    },
                    "consensus": {
                      "type": "string"
                    },
                    "release_date": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "source_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
